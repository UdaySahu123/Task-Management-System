# =============================================================================
# Copy this file to ".env" in the same folder and fill in real values.
# The ".env" file is git-ignored and must never be committed.
# =============================================================================

# --- Database (MySQL 8) -------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/task_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=taskapp
DB_PASSWORD=change-me-in-your-local-env

# --- Security ---------------------------------------------------------------
# Generate a strong value, e.g.:  openssl rand -base64 48
# Must be at least 32 characters long.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Token lifetime in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# --- Server / CORS ----------------------------------------------------------
SERVER_PORT=8080
# Comma separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
